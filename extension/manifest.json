{
  "manifest_version": 3,
  "name": "BookmarkSoft Launcher",
  "version": "1.0",
  "description": "Quickly search and launch over 100+ developer utilities directly from your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.jpeg",
      "48": "icon48.jpeg",
      "128": "icon128.jpeg"
    }
  },
  "icons": {
    "16": "icon16.jpeg",
    "48": "icon48.jpeg",
    "128": "icon128.jpeg"
  },
  "permissions": []
}
